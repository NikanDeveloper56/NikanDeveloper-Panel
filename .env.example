# This file serves a dual purpose:
# 1. Developer Bootstrap: The active (uncommented) variables directly below 
#    configure a safe, unprivileged local environment for 'go run .'. 
#    This allows 'cp .env.example .env' to work out-of-the-box without root.
# 2. Production Reference: All available NikanDeveloper_* configuration options are 
#    documented and commented out in the reference section further below.
#
# Nikan.Developer reads its runtime configuration from NikanDeveloper_* environment variables. 
# On a script install, the installer writes them to the service environment file 
# (/etc/default/nikan-developer, /etc/conf.d/nikan-developer, or /etc/sysconfig/nikan-developer depending on the distro).
# For Docker, you set them in docker-compose.yml or via 'docker run -e'.
#
# Defaults are sensible — set only what you need to change, then restart:
# systemctl restart nikan-developer

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT OVERRIDES (ACTIVE BY DEFAULT)
# ------------------------------------------------------------------------------
NikanDeveloper_DEBUG=true
NikanDeveloper_DB_FOLDER=nikan-developer
NikanDeveloper_LOG_FOLDER=nikan-developer
NikanDeveloper_BIN_FOLDER=nikan-developer
NikanDeveloper_INIT_WEB_BASE_PATH=/

# ==============================================================================
# REFERENCE CONFIGURATION (ALL OPTIONS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Backend database type: sqlite, or postgres (also accepts postgresql / pg)
# Default: sqlite
#NikanDeveloper_DB_TYPE=sqlite

# Folder for the SQLite database file (nikan-developer.db)
# Default: /etc/nikan-developer (Overridden to 'nikan-developer' in the development block above)
#NikanDeveloper_DB_FOLDER=/etc/nikan-developer

# PostgreSQL connection string (used when NikanDeveloper_DB_TYPE=postgres)
# Example: postgres://user:password@localhost:5432/dbname?sslmode=disable
#NikanDeveloper_DB_DSN=

# Max open connections in the PostgreSQL pool
#NikanDeveloper_DB_MAX_OPEN_CONNS=

# Max idle connections in the PostgreSQL pool
#NikanDeveloper_DB_MAX_IDLE_CONNS=

# PostgreSQL Docker Container Settings
# Default credentials used if you are running PostgreSQL via docker-compose
#POSTGRES_USER=xui
#POSTGRES_PASSWORD=xui
#POSTGRES_DB=xui


# ------------------------------------------------------------------------------
# Panel
# ------------------------------------------------------------------------------
# Override the panel port (1–65535). Takes precedence over the stored setting.
#NikanDeveloper_PORT=

# Initial web base path on FIRST launch (e.g., /panel)
# Default: /
#NikanDeveloper_INIT_WEB_BASE_PATH=/

# Enable Fail2ban-based IP-limit enforcement
# Default: true
#NikanDeveloper_ENABLE_FAIL2BAN=true

# Skip the HSTS header — set true when TLS is terminated by a reverse proxy
# Default: false
#NikanDeveloper_SKIP_HSTS=false


# ------------------------------------------------------------------------------
# Logging & binaries
# ------------------------------------------------------------------------------
# Logging level: debug, info, notice, warning, or error
# Default: info
#NikanDeveloper_LOG_LEVEL=info

# Debug mode. Forces log level to debug, enables Gin debug mode, 
# and ensures frontend assets are served directly from disk (see CLAUDE.md).
# Default: false (Overridden to 'true' in the development block at the top)
#NikanDeveloper_DEBUG=false

# Log output directory
# Default: /var/log/nikan-developer (Overridden to 'nikan-developer' in the development block above)
#NikanDeveloper_LOG_FOLDER=/var/log/nikan-developer

# Folder for the Xray-core binary and geosite/geoip files
# Default: bin (Overridden to 'nikan-developer' in the development block above)
#NikanDeveloper_BIN_FOLDER=bin

# Legacy Path Settings
# Main installation folder (Default: /usr/local/nikan-developer for Linux, /app for Docker)
#NikanDeveloper_MAIN_FOLDER=/usr/local/nikan-developer
# Path to the systemd service file (Default: /etc/systemd/system)
#NikanDeveloper_SERVICE=/etc/systemd/system


# ------------------------------------------------------------------------------
# Memory & profiling
# ------------------------------------------------------------------------------
# Go GC target percentage; lower = less RAM, slightly more CPU.
# Default: 75
#NikanDeveloper_GOGC=

# Minutes between FreeOSMemory calls; 0 disables.
# Default: 10
#NikanDeveloper_MEMORY_RELEASE_INTERVAL=

# Go soft memory limit in MiB
#NikanDeveloper_MEMORY_LIMIT=

# Go-syntax soft limit (e.g., 400MiB); takes precedence over NikanDeveloper_MEMORY_LIMIT
#GOMEMLIMIT=

# Expose pprof profiling on 127.0.0.1:6060
# Default: false
#NikanDeveloper_PPROF=false

# Automatically set to 'true' inside the official Docker image.
# Consumed by internal scripts (nikan-developer.sh) to detect the environment.
# There is normally no need to set or toggle this variable manually.
# Default: false (automatically 'true' in Docker environments)
#NikanDeveloper_IN_DOCKER=false


# ------------------------------------------------------------------------------
# Xray
# ------------------------------------------------------------------------------
# Force VMess AEAD
# Default: false
#XRAY_VMESS_AEAD_FORCED=false


# ------------------------------------------------------------------------------
# Tunnel health monitor
# ------------------------------------------------------------------------------
# Optional watchdog: probes a URL (optionally through a local Xray inbound)
# and restarts Xray after repeated failures. A restart drops all connected clients.
# Default: false
#NikanDeveloper_TUNNEL_HEALTH_MONITOR=false

# Proxy to send the probe through, e.g., socks5://127.0.0.1:1080
# Empty = only checks host connectivity
#NikanDeveloper_TUNNEL_HEALTH_PROXY=

# URL to probe
# Default: https://www.cloudflare.com/cdn-cgi/trace
#NikanDeveloper_TUNNEL_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace

# Interval between probes
# Default: 30s
#NikanDeveloper_TUNNEL_HEALTH_INTERVAL=30s

# Per-probe timeout
# Default: 10s
#NikanDeveloper_TUNNEL_HEALTH_TIMEOUT=10s

# Consecutive failures before a restart
# Default: 3
#NikanDeveloper_TUNNEL_HEALTH_FAILURES=3

# Minimum delay between restarts
# Default: 5m
#NikanDeveloper_TUNNEL_HEALTH_COOLDOWN=5m


# ------------------------------------------------------------------------------
# Unattended install
# ------------------------------------------------------------------------------
# Set to 1 (or run with no TTY) to install with zero prompts.
# Generated credentials will be written to /etc/nikan-developer/install-result.env
#NikanDeveloper_NONINTERACTIVE=1
